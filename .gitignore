# Dependencies — node_modules is a junction into the local sandbox so the
# harnesses can resolve @deepseek-ai/dsh-home-paths. Never commit it.
node_modules/

# A DSH_HOME holds live credentials (.credentials.yaml, .anonymous-user-id) and
# session state. Ignore the shapes one could take, so a stray `git add -A` can
# never stage them even if a sandbox is created here later.
home/
.sandbox/home/
.sandbox-next/

# Pack output
*.tgz
.sandbox/pack/

# Logs — every gate run redirects into one, and 67 of them had piled up
# untracked, which is exactly what an accidental `git add -A` would commit.
*.log
*.log.*

# Runtime artifacts the gates produce
.sandbox/received.json
.sandbox/variant-*.mjs

# One-off diagnostic scratch
.sandbox/_probe*.cjs
.sandbox/_bisect*.cjs
.sandbox/_dbg*
.sandbox/_fetchprobe*
.sandbox/_head*
.sandbox/diag.mjs
.sandbox/_rebuild.cjs
.sandbox/_head.tmp
.sandbox/_tail.tmp
.sandbox/release-notes.md
.sandbox/diag-built.cjs
.sandbox/probe-overlay.mjs

.sandbox/commit-msg.txt
